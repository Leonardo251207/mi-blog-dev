# ============================================================
#  DevBlog CMS API — configuración de ejemplo
#  Copia este archivo como `.env` y ajusta los valores.
# ============================================================

# Identidad del servicio (sirve para reutilizar la API en otro proyecto)
CMS_APP_NAME=DevBlog CMS API
CMS_APP_DESCRIPTION=API de Gestión de Contenido del DevBlog (Diseño API-First, v1.2).
CMS_APP_VERSION=1.2.0
CMS_ENV=development
CMS_API_PREFIX=/api/v1

# Persistencia SQLite (local). La carpeta se crea automáticamente.
CMS_DB_PATH=data/devblog.db

# Opcional: MongoDB Atlas. Si defines CMS_MONGO_URI, el CMS usa Mongo en vez de SQLite.
# CMS_MONGO_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# CMS_MONGO_DB=devblog_cms

# Tokens (cámbialos en producción)
CMS_CONSOLE_TOKEN=console-dev-token
CMS_PUBLIC_TOKEN=public-dev-token

# Secreto para firmar los cursores de paginación. Cámbialo en producción.
CMS_CURSOR_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# CORS: separa los orígenes con comas. "*" permite todos (solo desarrollo).
CMS_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080,null

# URL que se devuelve al publicar.
# - Si CMS_PUBLIC_SITE_URL está vacío, el campo `url` es relativo.
# - CMS_PUBLIC_ARTICLE_PATH debe contener {slug}.
#   Para el blog estático: /articulo.html?slug={slug}
#   Para una ruta tipo blog: /blog/{slug}
CMS_PUBLIC_SITE_URL=
CMS_PUBLIC_ARTICLE_PATH=/articulo.html?slug={slug}

# Ventana de idempotencia en segundos (24 h por defecto)
CMS_IDEMPOTENCY_TTL_S=86400

# Límites de tráfico (los valores del contrato)
CMS_CONSOLE_RATE_LIMIT=60
CMS_CONSOLE_RATE_WINDOW_S=60
CMS_PUBLIC_RATE_LIMIT=10
CMS_PUBLIC_RATE_WINDOW_S=1

# Logs
CMS_LOG_LEVEL=INFO
